@model TechStoreMVC.Models.Categoria

@{
    ViewData["Title"] = "Editar categorias";
}

<h1>Editar categorias</h1>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Nome"
               class="form-label"></label>
        <input asp-for="Nome"
               class="form-control" />
        <span asp-validation-for="Nome"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descricao"
               class="form-label"></label>
        <input asp-for="Descricao"
               class="form-control" />
        <span asp-validation-for="Descricao"
              class="text-danger"></span>
    </div>

    @* <div class="mb-3">
        <label asp-for="Ativa"
               class="form-label"></label>
        <input asp-for="Ativa"
               class="form-control" />
        <span asp-validation-for="Ativa"
              class="text-danger"></span>
    </div> *@

    <button type="submit"
            class="btn btn-warning">
        Salvar alterações
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}