@*Passo 3- criar views*@
@model TechStoreMVC.Models.Produto

@{
    ViewData[index: "Title"] = "Produtos";
}
<h1> Lista de produtos </h1>

<dl>

<dt>class= "col-sm-2>Nome</dt>
<dd>class= "col-sm-10>@Model.Nome</dd>

<dt>class= "col-sm-2>Preço</dt>
<dd>class= "col-sm-10>@Model.Preco.ToString(format:"C")</dd>

<dt>class= "col-sm-2>Estoque</dt>
<dt>class= "col-sm-10>@Model.Estoque</dt>
</dl>

<a asp-action="= "Edit"
asp-route-id="@Model.Id"
class= "btn btn-warning">
Editar
</a>

<a asp-action= "Index"
asp-route-id="@Model.Id"
class= "btn btn-warning">
Voltar 
</a>