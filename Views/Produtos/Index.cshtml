@*Passo 3- criar views*@
@model List<TechStoreMVC.Models.Produto>

@{
    ViewData[index: "Title"] = "Produtos";
}
<h1> Lista de produtos </h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Preço</th>
            <th>Estoque</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var produto in Model)
        {
            <tr>
                <td> @produto.Id</td>
                <td> @produto.Nome</td>
                <td> @produto.Preco.ToString(format: "F2")</td>
                <td> @produto.Estoque</td>
                <td>
                   <a asp-action="Details" asp-route-id="produto.Id" class= "btn btn-primary" >
                   |Detalhes
                   </a>
                   <a asp-action="Edit" asp-route-id="produto.Id" class= "btn btn-primary" >
                   |Edit
                   </a>
                   <a asp-action="Delete" asp-route-id="produto.Id" class= "btn btn-primary" >
                   |Delete
                   </a>
                   <a asp-action="Create" asp-route-id="produto.Id" class= "btn btn-primary" >
                   |Create
                   </a>
                </td>
            </tr>
        }
    </tbody>
</table>